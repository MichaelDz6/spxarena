---
import SiteLayout from '../layouts/SiteLayout.astro';
import { calculateHistory, defaultCalculator } from '../lib/calculator.js';
import monthlyData from '../data/spy-monthly-prices.json';
import { dollars } from '../lib/performance.js';
const result = calculateHistory(monthlyData.prices, defaultCalculator);
---

<SiteLayout
  title="SPY Investment Calculator"
  description="Replay historical S&P 500 investing with a starting amount and monthly contributions."
  ><main
    class="arena-page calculator-page"
    data-page="calculator"
    aria-labelledby="calculator-page-title"
  >
    <div class="page-intro">
      <a href="/" class="back-link cursor-interaction">← Back to the arena</a
      ><span class="small-label"
        >THE QUIET CONTENDER · INVESTMENT CALCULATOR</span
      ><h1 id="calculator-page-title">
        Small steps.<br /><em>A longer story.</em>
      </h1><p>
        What could your money have become? Pick a start date, add a monthly
        contribution, and follow the S&amp;P 500 through SPY.
      </p>
    </div>
    <div class="calculator-layout">
      <form class="investment-form" data-calculator-form>
        <noscript
          ><p>
            This calculator needs JavaScript. The default historical result is
            shown alongside.
          </p></noscript
        >
        <div class="form-heading">
          <span class="small-label">BUILD YOUR SCENARIO</span><span
            class="history-tag">HISTORICAL</span>
        </div>
        <label for="arena-initial">Starting investment <span>USD</span></label
        ><div class="money-input">
          <span aria-hidden="true">$</span><input
            class="cursor-interaction"
            id="arena-initial"
            name="initial"
            type="number"
            inputmode="decimal"
            min="0"
            max="100000000"
            step="any"
            value="10000"
            required
          />
        </div>
        <label for="arena-monthly">Monthly contribution <span>USD</span></label
        ><div class="money-input">
          <span aria-hidden="true">$</span><input
            class="cursor-interaction"
            id="arena-monthly"
            name="monthly"
            type="number"
            inputmode="decimal"
            min="0"
            max="10000000"
            step="any"
            value="250"
            required
          />
        </div>
        <div class="date-fields">
          <div>
            <label for="arena-start">Start month</label><input
              class="cursor-interaction"
              id="arena-start"
              name="start"
              type="month"
              min="2016-01"
              max="2025-12"
              value="2016-01"
              required
            />
          </div><div>
            <label for="arena-end">End month</label><input
              class="cursor-interaction"
              id="arena-end"
              name="end"
              type="month"
              min="2016-01"
              max="2025-12"
              value="2025-12"
              required
            />
          </div>
        </div>
        <label for="arena-timing">Add money at the</label><select
          class="cursor-interaction"
          name="timing"
          id="arena-timing"
          ><option value="end">End of each month</option><option
            value="beginning">Beginning of each month</option
          ></select
        >
        <button
          class="arena-action cursor-interaction"
          type="submit"
          data-calculate
          >Calculate my journey <span aria-hidden="true">→</span></button
        >
        <p class="calculator-error" data-calculator-error role="alert" hidden>
        </p>
        <p class="form-footnote">
          Available history: Jan 2016 – Dec 2025.<br />Dividends reinvested. All
          amounts in USD.
        </p>
      </form>
      <section class="calculator-result" aria-labelledby="calculation-heading">
        <div class="result-topline">
          <span class="small-label" id="calculation-heading"
            >YOUR HISTORICAL RESULT</span
          ><span class="result-period" data-calc-period
            >Jan 2016 – Dec 2025</span>
        </div>
        <div class="result-wealth" aria-live="polite">
          <span>Portfolio value</span><strong data-calc-value
            >{dollars(result.value)}</strong
          ><small data-calc-summary
            >120 monthly additions of $250 · dividends reinvested</small>
        </div>
        <div class="result-split" aria-live="polite">
          <div>
            <span>You invested</span><strong data-calc-invested
              >{dollars(result.invested)}</strong>
          </div><div>
            <span>Investment gain / loss</span><strong data-calc-gain class="up"
              >+{dollars(result.gain)}</strong>
          </div>
        </div>
        <div class="calc-chart-wrap">
          <svg
            class="calculator-chart"
            data-calc-chart
            role="img"
            aria-label="Portfolio value and total contributions over time"
          ></svg><div class="calc-tooltip" data-calc-tooltip hidden></div>
        </div>
        <div class="calc-chart-legend">
          <span><i></i>Portfolio value</span><span
            ><i></i>Your contributions</span>
        </div>
      </section>
    </div>
    <details class="calculator-method">
      <summary>How this calculation works &amp; data sources</summary><p>
        Uses SPY’s dividend- and split-adjusted closing price on the last
        trading day of each month. The starting investment is valued at the
        close immediately before your start month. Monthly additions use
        month-end prices; “beginning” uses the previous month’s closing price.
        Fractional shares and reinvested distributions are assumed.
      </p><p>
        Values are historical estimates before personal taxes, trading costs and
        inflation. ETF expenses are reflected in its prices. This is a
        historical replay, not a forecast or a guaranteed return. Monthly
        endpoints do not show fluctuations within each month.
      </p><p>
        Price source: <a
          href="https://finance.yahoo.com/quote/SPY/history/"
          target="_blank"
          rel="noopener noreferrer"
          >Yahoo Finance · SPY adjusted daily closes ↗</a
        >, sampled at month-end. Snapshot retrieved Oct 4, 2026; calculator ends
        Dec 31, 2025 to match this arena’s research period. <a
          href="https://www.ssga.com/us/en/individual/etfs/state-street-spdr-sp-500-etf-trust-spy"
          target="_blank"
          rel="noopener noreferrer">About the SPY ETF ↗</a
        >. Small differences from the leaderboard reflect price-source precision
        and published rounded annual returns.
      </p>
    </details>
  </main></SiteLayout
>
<script>
  import '../scripts/calculator.js';
</script>
