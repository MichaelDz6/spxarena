---
import ArenaVictory from '../components/ArenaVictory.astro';
import SiteLayout from '../layouts/SiteLayout.astro';
import Portrait from '../components/Portrait.astro';
import '../styles/leaderboard.css';
import {
  investors,
  rankedInvestors,
  rankedById,
  benchmarkStats,
  fmt,
  titleCase,
} from '../lib/performance.js';

const benchmark = benchmarkStats[10];
const firstBelowBenchmark = rankedInvestors.find((d) => d.gap < 0)?.key;
const minimum =
  Math.floor(Math.min(0, ...rankedInvestors.map((d) => d.value)) / 5) * 5;
const maximum =
  Math.ceil(Math.max(benchmark, ...rankedInvestors.map((d) => d.value)) / 5) *
  5;
const position = (value: number) =>
  ((value - minimum) / (maximum - minimum)) * 100;
const barStyle = (value: number) =>
  `left:${position(Math.min(0, value))}%;width:${(Math.abs(value) / (maximum - minimum)) * 100}%`;
const ticks = Array.from(
  { length: (maximum - minimum) / 5 + 1 },
  (_, i) => minimum + i * 5,
);
---

<SiteLayout
  title="Investor Leaderboard"
  description="Twenty fund and company records ranked by ten-year annualized returns versus SPY, plus fourteen unranked famous investor profiles."
>
  <main
    class="arena-page ranking-page"
    aria-labelledby="ranking-page-title"
    style={`--ranking-zero:${position(0)}%;--ranking-spx:${position(benchmark)}%`}
  >
    <div class="page-intro">
      <a href="/" class="back-link">← Back to the arena</a><span
        class="small-label">THE COMPLETE ARENA · 34 INVESTORS</span
      ><h1 id="ranking-page-title">Fame meets <em>the record.</em></h1><p>
        Thirty-four familiar names. Twenty fund and company records ranked over
        2016–2025. Explore the other fourteen profiles below as their records
        are reviewed.
      </p>
    </div>
    <div class="ranking-key">
      <span class="small-label">20 RANKED VEHICLES · JAN 2016 – DEC 2025</span>
      <span
        ><i aria-hidden="true"></i>Gold marker = SPX · Bars = 10Y / year</span
      >
    </div>
    <div
      class="ranking-row ranking-spx benchmark-row"
      aria-label="SPX benchmark"
    >
      <div class="bar-identity">
        <ArenaVictory />
        <span class="bar-benchmark-icon" aria-hidden="true">◆</span>
        <div>
          <strong>SPX · S&amp;P 500</strong>
          <small>SPY ETF · THE BENCHMARK</small>
        </div>
      </div>
      <div class="ranking-plot" aria-hidden="true">
        <div class="bar-track">
          <span class="bar-fill" style={barStyle(benchmark)}></span>
        </div>
        <div class="ranking-axis">
          {
            ticks.map((tick) => (
              <span style={`left:${position(tick)}%`}>{tick}%</span>
            ))
          }
        </div>
      </div>
      <div class="bar-value">
        <strong>{fmt(benchmark)}%</strong>
        <small>10Y / YEAR</small>
      </div>
    </div>
    <ol
      class="ranking-list"
      role="list"
      aria-label="Investors ranked by ten-year annualized return"
    >
      {
        rankedInvestors.map((d) => (
          <li>
            {d.key === firstBelowBenchmark && (
              <div class="ranking-loss-section">
                <h2>Defeated Underperformers</h2>
                <hr
                  class="ranking-loss-divider"
                  aria-label="Below SPX over ten years"
                />
              </div>
            )}
            <a
              class="ranking-row ranking-entry"
              href={`/investors/${d.key}/`}
              data-tier={d.tier}
            >
              <div class="bar-identity">
                <span class="bar-rank" aria-hidden="true">
                  {String(d.rank).padStart(2, '0')}
                </span>
                <Portrait person={d.key} />
                <div>
                  <strong>
                    {d.name}
                    <span class="ranking-profile-arrow" aria-hidden="true">
                      ↗
                    </span>
                  </strong>
                  <span class="rarity-badge ranking-tier" data-tier={d.tier}>
                    {titleCase(d.tier)}
                  </span>
                  <small>{d.vehicle}</small>
                </div>
              </div>
              <div class="ranking-plot" aria-hidden="true">
                <div class="bar-track">
                  <span
                    class:list={['bar-fill', { 'is-negative': d.value < 0 }]}
                    style={barStyle(d.value)}
                  />
                </div>
              </div>
              <div class="bar-value">
                <strong>
                  {fmt(d.value)}%
                  <span class="rating-sr"> ten-year annualized return</span>
                </strong>
                <small>
                  <span
                    class:list={['excess-return', d.gap >= 0 ? 'up' : 'down']}
                  >
                    {fmt(d.gap, 2)} pp
                  </span>{' '}
                  vs SPX / yr
                </small>
              </div>
            </a>
          </li>
        ))
      }
    </ol>
    <p class="ranking-explainer">
      Rankings and rarity badges use ten-year annualized returns. A vehicle’s
      return is not the investor’s personal return; fund NAV, market value and
      composite figures are identified below each name. Figures are approximate
      USD total returns. Bars extend from zero; negative returns extend to the
      left. Gaps are in percentage points (pp) per year.
    </p>
    <section class="unranked-section" aria-labelledby="unranked-title">
      <span class="small-label">14 MORE FAMILIAR FACES</span><h2
        id="unranked-title"
      >
        In the arena. Awaiting a rank.
      </h2><p>
        Historical careers and records still under review. Unranked means no
        comparable score has been assigned; it does not mean the investor lost
        to the market.
      </p><div class="unranked-list">
        {
          investors
            .filter((d) => !rankedById[d.key])
            .map((d) => (
              <a class="unranked-entry" href={`/investors/${d.key}/`}>
                <>
                  <Portrait person={d.key} />
                  <span>
                    <>
                      <strong>{d.name}</strong>
                      <small>
                        {d.status} · {d.vehicle}
                      </small>
                    </>
                  </span>
                  <span aria-hidden="true">↗</span>
                </>
              </a>
            ))
        }
      </div>
    </section>
    <div class="ranking-links">
      <a class="arena-action secondary" href="/etfs-arena/"
        >ETFs Arena <span aria-hidden="true">→</span></a
      >
      <a class="arena-action secondary" href="/#nine-arena-rules"
        >Read the ranking rules <span aria-hidden="true">→</span></a
      ><a class="arena-action" href="/calculator/"
        >Investment Calculator <span aria-hidden="true">→</span></a
      >
    </div>
  </main>
</SiteLayout>
