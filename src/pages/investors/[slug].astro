---
import PortraitCredit from '../../components/PortraitCredit.astro';
import SiteLayout from '../../layouts/SiteLayout.astro';
import Portrait from '../../components/Portrait.astro';
import RecordDetail from '../../components/RecordDetail.astro';
import InvestorPerformance from '../../components/InvestorPerformance.astro';
import biographies from '../../data/investor-biographies.json';
import {
  investors,
  rankedById,
  rankedInvestors,
  titleCase,
} from '../../lib/performance.js';
import '../../styles/investor-profile.css';
export function getStaticPaths() {
  return investors.map((profile) => ({
    params: { slug: profile.key },
    props: { profile },
  }));
}
const { profile } = Astro.props;
const record = rankedById[profile.key];
const biography = biographies[profile.key as keyof typeof biographies];
const devastationThreshold = 5;
const verdict = !Number.isFinite(record?.gap)
  ? 'unranked'
  : record.gap > 0
    ? 'win'
    : record.gap <= -devastationThreshold
      ? 'devastated'
      : record.gap < 0
        ? 'loss'
        : 'tie';
const verdictLabels = {
  win: 'Beat SPX',
  loss: 'Defeated by SPX',
  devastated: 'Devastated by SPX',
  tie: 'Matched SPX',
  unranked: 'No verdict yet',
};
const shield = 'M12 22s8-4 8-11V5l-8-3-8 3v6c0 7 8 11 8 11Z';
const verdictIcons = {
  win: 'M8 21h8m-4-4v4M7 3h10v7a5 5 0 0 1-10 0V3Zm10 2h4v3a4 4 0 0 1-4 4M7 5H3v3a4 4 0 0 0 4 4',
  loss: `${shield}M9 9l6 6m0-6-6 6`,
  devastated:
    'M12 2 4 5v6c0 7 8 11 8 11l-2-7 4-3-4-4 2-6Zm4 1.5L20 5v6c0 3-1.5 5.5-3.5 7.5',
  tie: `${shield}M9 10h6m-6 4h6`,
  unranked: `${shield}M9 12h6`,
};
---

<SiteLayout title={profile.name} description={biography.description}>
  <main
    class="arena-page investor-profile-page"
    aria-labelledby="investor-profile-title"
  >
    <div class="profile-breadcrumb">
      <a href="/#nine-arena-contenders" class="back-link">← All investors</a
      ><span class="small-label">THE ARENA · INVESTOR PROFILE</span>
    </div>
    <section class="profile-hero" aria-labelledby="investor-profile-title">
      <figure class="profile-portrait" data-tier={record?.tier || 'unrated'}>
        <div class="profile-portrait-frame">
          <Portrait person={profile.key} />
        </div>
        <figcaption class="profile-rarity">
          <span>{record ? '10-YEAR RARITY' : 'RECORD STATUS'}</span>
          <strong
            ><i aria-hidden="true">◆</i>{
              record ? titleCase(record.tier) : 'Unranked'
            }<i aria-hidden="true">◆</i></strong
          >
          <div class="profile-verdict" data-result={verdict}>
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.6"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
              focusable="false"><path d={verdictIcons[verdict]}></path></svg
            >
            <span>{verdictLabels[verdict]}</span>
          </div>
          <small
            >{
              record ? (
                <>
                  <>
                    <span>
                      Rank {record.rank} of {rankedInvestors.length}
                    </span>
                    <span>2016–2025</span>
                  </>
                </>
              ) : (
                'Comparable data needed'
              )
            }</small
          >
        </figcaption>
        <PortraitCredit person={profile.key} />
      </figure>
      <div class="profile-heading">
        <span class="small-label">{profile.category}</span>
        <h1 id="investor-profile-title">{profile.name}</h1>
        <p class="profile-fame">{biography.fame}</p>
      </div>
      <div class="profile-biography">
        <p>{biography.description}</p>
        <a
          class="profile-biography-source"
          href={biography.source}
          target="_blank"
          rel="noopener noreferrer">{biography.sourceLabel} ↗</a
        >
        <div class="profile-fund">
          <span class="small-label"
            >{record ? 'THE RECORD WE COMPARE' : 'ASSOCIATED WITH'}</span
          ><strong>{record?.vehicle || profile.vehicle}</strong>
        </div>
        <p class="profile-rating-explanation">
          {
            record
              ? 'Rarity and verdict reflect this vehicle’s 10-year return versus SPX, measured through SPY. They rate 2016–2025, not the investor’s entire career.'
              : 'No rarity, verdict or leaderboard position is assigned until a comparable return record is verified.'
          }
          {
            verdict === 'devastated' && (
              <span class="profile-verdict-rule">
                “Devastated by SPX” means a 10-year annualized return at least{' '}
                {devastationThreshold} percentage points below the benchmark.
              </span>
            )
          }
        </p>
        <div class="profile-hero-actions">
          <a href="#performance" class="arena-action"
            >{record ? 'See the comparison' : 'View the available record'}
            <span aria-hidden="true">↓</span></a
          ><a href="/leaderboard/" class="profile-leaderboard-link"
            >Full leaderboard ↗</a
          >
        </div>
      </div>
    </section>
    <InvestorPerformance person={profile.key} />
    {
      record ? (
        <details class="profile-data record-details">
          <>
            <summary>Sources, annual returns &amp; consistency</summary>
            <RecordDetail investor={record} />
          </>
        </details>
      ) : (
        <div class="profile-unranked-source">
          <>
            <span class="small-label">FURTHER READING</span>
            <a href={profile.source} target="_blank" rel="noopener noreferrer">
              {profile.sourceLabel} ↗
            </a>
            <p>
              Public holdings, media appearances and estimated wealth do not
              establish a complete investment return.
            </p>
          </>
        </div>
      )
    }
  </main>
</SiteLayout>
