---
interface Props {
  snapshotLabel?: string;
}
const { snapshotLabel = 'Historical snapshot through 2025' } = Astro.props;
const linkGroups = [
  {
    title: 'Explore',
    links: [
      { href: '/', label: 'The arena' },
      { href: '/leaderboard/', label: 'Leaderboard' },
      { href: '/etfs-arena/', label: 'ETFs Arena' },
      { href: '/arena-of-ruin/', label: 'Arena of Ruin' },
    ],
  },
  {
    title: 'Learn',
    links: [
      { href: '/what-is-spx/', label: 'What is SPX?' },
      { href: '/calculator/', label: 'Investment Calculator' },
    ],
  },
  {
    title: 'SPX Arena',
    links: [
      { href: '/about/', label: 'About' },
      { href: '/credits/', label: 'Credits & licenses' },
    ],
  },
];
const currentPath = `${Astro.url.pathname.replace(/\/+$/, '')}/`;
---

<footer class="home-footer">
  <div class="footer-top">
    <div class="footer-brand">
      <a class="home-logo" href="/#nine-arena-top">
        <span class="logo-gem" aria-hidden="true"></span>
        <span class="logo-wordmark">SPX <em>ARENA</em></span>
      </a>
      <p class="footer-motto">FAME IS NOT A BENCHMARK.</p>
      <p class="footer-purpose">
        Real records. Clear comparisons.<br />Learn how investing works.
      </p>
    </div>
    <nav class="footer-navigation" aria-label="Footer navigation">
      {
        linkGroups.map((group) => (
          <div class="footer-link-group">
            <h2>{group.title}</h2>
            <ul>
              {group.links.map((link) => (
                <li>
                  <a
                    href={link.href}
                    aria-current={
                      link.href === currentPath ? 'page' : undefined
                    }
                  >
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </nav>
  </div>
  <div class="footer-bottom">
    <p>
      Independent educational comparison. No affiliation or endorsement by
      S&amp;P DJI, State Street, or the people and firms shown. Not investment
      advice.
    </p>
    <p class="footer-snapshot">{snapshotLabel}</p>
  </div>
</footer>

<style>
  :global(#spx-nine-in-ten) .home-footer {
    display: block;
    padding-block: 40px 24px;
  }
  :global(#spx-nine-in-ten) .footer-top {
    display: grid;
    grid-template-columns: minmax(220px, 1fr) minmax(0, 1.7fr);
    gap: 48px;
  }
  :global(#spx-nine-in-ten) .footer-brand .home-logo {
    width: fit-content;
  }
  :global(#spx-nine-in-ten) .footer-motto {
    margin-top: 20px;
    color: #dfcea0;
    font:
      10px/1.8 'IBM Plex Mono',
      monospace;
    letter-spacing: 0.8px;
  }
  :global(#spx-nine-in-ten) .footer-purpose {
    margin-top: 8px;
    color: #e0e9e1;
    font-size: 13px;
    line-height: 1.8;
  }
  :global(#spx-nine-in-ten) .footer-navigation {
    display: grid;
    grid-template-columns: 0.8fr 1.2fr 1fr;
    gap: 24px;
  }
  :global(#spx-nine-in-ten) .footer-link-group h2 {
    margin-bottom: 12px;
    color: #dfcea0;
    font:
      11px/1.6 'IBM Plex Mono',
      monospace;
    letter-spacing: 1px;
    text-transform: uppercase;
  }
  :global(#spx-nine-in-ten) .footer-link-group ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  :global(#spx-nine-in-ten) .footer-link-group a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding-block: 8px;
    font-size: 13px;
  }
  :global(#spx-nine-in-ten) .footer-link-group a[aria-current='page'] {
    color: #dfcea0;
    text-decoration: underline;
  }
  :global(#spx-nine-in-ten) .home-footer a:focus-visible {
    outline-color: #dfcea0;
  }
  :global(#spx-nine-in-ten) .footer-bottom {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 20px;
    margin-top: 32px;
    padding-top: 20px;
    border-top: 1px solid #dfcea040;
    color: #e0e9e1;
    font-size: 11px;
    line-height: 1.8;
  }
  :global(#spx-nine-in-ten) .footer-bottom > p:first-child {
    max-width: 650px;
  }
  :global(#spx-nine-in-ten) .footer-snapshot {
    flex-shrink: 0;
    font-size: 10px;
  }
  @media (max-width: 800px) {
    :global(#spx-nine-in-ten) .footer-top {
      grid-template-columns: 1fr;
      gap: 32px;
    }
    :global(#spx-nine-in-ten) .footer-bottom {
      align-items: flex-start;
      flex-direction: column;
      gap: 12px;
    }
  }
  @media (max-width: 480px) {
    :global(#spx-nine-in-ten) .footer-navigation {
      grid-template-columns: 1fr 1fr;
      gap: 24px 20px;
    }
  }
</style>
