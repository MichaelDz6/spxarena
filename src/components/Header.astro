---
interface Props {
  edition?: { label: string; period: string };
}
const { edition = { label: 'THE LONG GAME', period: '2016 — 2025' } } =
  Astro.props;
const links = [
  { href: '/', label: 'The arena' },
  { href: '/what-is-spx/', label: 'What is SPX?' },
  { href: '/leaderboard/', label: 'Leaderboard' },
  { href: '/calculator/', label: 'Investment Calculator' },
  { href: '/etfs-arena/', label: 'ETFs Arena' },
  { href: '/arena-of-ruin/', label: 'Arena of Ruin' },
];
const currentPath = `${Astro.url.pathname.replace(/\/+$/, '')}/`;
---

<header class="home-nav">
  <a class="home-logo" href="/#nine-arena-top">
    <span class="logo-gem" aria-hidden="true"></span>
    <span class="logo-wordmark">SPX <em>ARENA</em></span>
  </a>
  <button
    class="nav-toggle"
    type="button"
    aria-expanded="false"
    aria-controls="main-navigation"
    aria-label="Open navigation"
    hidden
  >
    <span>Menu</span>
    <svg viewBox="0 0 20 20" aria-hidden="true"
      ><path d="M3 6h14M3 14h14"></path></svg
    >
  </button>
  <nav id="main-navigation" aria-label="Main navigation">
    {
      links.map((link) => (
        <a
          href={link.href}
          aria-current={link.href === currentPath ? 'page' : undefined}
        >
          {link.label}
        </a>
      ))
    }
  </nav>
  <span class="edition-label"
    >{edition.label}<br /> <b>{edition.period}</b></span
  >
</header>
<script>
  import '../scripts/navigation.js';
</script>

<style>
  @media (min-width: 901px) and (max-width: 1150px) {
    :global(#spx-nine-in-ten) .home-nav .edition-label {
      display: none;
    }
    :global(#spx-nine-in-ten) .home-nav nav {
      gap: 14px;
      font-size: 12px;
    }
  }
</style>
