---
const arenaLinks = [
  { href: '/', label: 'The arena' },
  { href: '/leaderboard/', label: 'Leaderboard' },
  { href: '/etfs-arena/', label: 'ETFs Arena' },
  { href: '/calculator/', label: 'Investment Calculator' },
];
const learnLink = { href: '/what-is-spx/', label: 'What is SPX?' };
const currentPath = `${Astro.url.pathname.replace(/\/+$/, '')}/`;
const links = (
  currentPath === '/' ? [learnLink, ...arenaLinks] : [...arenaLinks, learnLink]
).filter((link) => link.href !== currentPath);
---

<header class="home-nav">
  <a class="home-logo" href="/#nine-arena-top"
    ><span class="logo-gem" aria-hidden="true"></span>SPX <em>ARENA</em></a
  >
  <button
    class="nav-toggle"
    type="button"
    aria-expanded="false"
    aria-controls="main-navigation"
    aria-label="Open navigation"
    hidden
  >
    <span>Menu</span>
    <svg viewBox="0 0 20 20" aria-hidden="true"
      ><path d="M3 6h14M3 14h14"></path></svg
    >
  </button>
  <nav id="main-navigation" aria-label="Main navigation">
    {
      links.map((link) => (
        <a href={link.href}>{link.label}</a>
      ))
    }
  </nav>
  <span class="edition-label">THE LONG GAME<br /> <b>2016 — 2025</b></span>
</header>
<script>
  import '../scripts/navigation.js';
</script>
