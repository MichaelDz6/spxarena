---
import {
  benchmarkReturns,
  benchmarkStats,
  accumulate,
  fmt,
  dollars,
} from '../lib/performance.js';
---

<section
  class="benchmark-stage"
  id="nine-arena-benchmark"
  aria-labelledby="nine-benchmark-heading"
>
  <div class="benchmark-story">
    <span class="small-label">EVERY ARENA HAS ITS STANDARD</span><h2
      id="nine-benchmark-heading"
    >
      The one <em>to beat.</em>
    </h2><p>
      No star manager. No bold forecasts.<br /> Just the S&amp;P 500, represented
      here<br /> by the SPY ETF.
    </p><a href="/what-is-spx/"
      >What is SPX? <span aria-hidden="true">↗</span></a
    >
  </div>
  <div class="benchmark-pedestal">
    <article
      class="arena-card market-card"
      data-tier="legendary"
      aria-label="SPX S&P 500 legendary benchmark card, measured using SPY ETF total returns"
    >
      <span class="card-crown"
        ><span class="card-gem" aria-hidden="true"></span><span
          class="rarity-word">LEGENDARY</span
        ><span class="card-gem" aria-hidden="true"></span></span
      >
      <div class="hero-window market-window">
        <svg
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          aria-hidden="true"
          ><path d="m2 8 5 4 5-9 5 9 5-4-3 12H5L2 8Z"></path><path d="M5 22h14"
          ></path></svg
        ><strong>SPX</strong><span class="market-five">500</span><small
          >THE MARKET</small
        >
      </div>
      <span class="name-scroll"
        ><strong>S&amp;P 500</strong><small
          >BENCHMARK · SPY ETF TOTAL RETURN</small
        ></span
      >
      <div class="market-main-stat">
        <strong data-benchmark-ten>{fmt(benchmarkStats[10])}%</strong><small
          >10Y ANNUALIZED RETURN</small
        >
      </div>
      <div class="market-secondary">
        <span
          ><small>5Y / YEAR</small><b data-benchmark-five
            >{fmt(benchmarkStats[5])}%</b
          ></span
        ><span
          ><small>1Y SEASON</small><b data-benchmark-one
            >{fmt(benchmarkStats[1])}%</b
          ></span
        >
      </div>
    </article>
    <span class="benchmark-role">A legendary benchmark. A common opponent.</span
    >
  </div>
  <div class="benchmark-facts">
    <span class="small-label">TEN YEARS. ONE STARTING LINE.</span><div
      class="benchmark-growth"
    >
      <small
        ><b class="initial-investment">$10,000</b> INVESTED AT THE START OF 2016</small
      ><strong data-benchmark-wealth
        >{dollars(accumulate(benchmarkReturns).at(-1))}</strong
      ><span>at the end of 2025, dividends reinvested.</span>
    </div><p>
      Every contender faces the same dates<br /> and the same benchmark. The card
      frame<br /> reflects 10-year outperformance.
    </p><span class="benchmark-ticker"
      >SPX = INDEX <span>·</span> SPY = ETF</span
    >
  </div>
</section>
