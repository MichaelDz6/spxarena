---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Sources from '../components/Sources.astro';
import '../styles/arena.css';
import '../styles/site.css';
interface Props {
  title?: string;
  description?: string;
}
const {
  title,
  description = 'Fame is not a benchmark. Compare 34 famous investors and 20 ten-year records with the S&P 500, measured through SPY.',
} = Astro.props;
const pageTitle = title
  ? `${title} | SPX Arena`
  : 'SPX Arena — Fame is not a benchmark';
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f7f7f2" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{pageTitle}</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <div id="spx-nine-in-ten">
      <div
        id="design-nine"
        class="fantasy arena-home gilded palette-pearl palette-light"
      >
        <Header />
        <div id="main-content" tabindex="-1"><slot /></div>
        <Sources />
        <Footer />
      </div>
    </div>
    <script>
      import '../scripts/portraits.js';
    </script>
  </body>
</html>
